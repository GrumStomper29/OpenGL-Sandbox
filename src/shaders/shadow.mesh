#version 460
#extension GL_NV_mesh_shader : require

layout (local_size_x=32) in;

layout (triangles) out;
layout (max_vertices=64, max_primitives=124) out;


out gl_MeshPerVertexNV
{
	vec4 gl_Position;
} gl_MeshVerticesNV[];

out Interpolant
{
	vec3 norm;
	vec2 uv;
	vec3 camPosMinusWorldVert;
	flat uint clusterId;
} OUT[];



struct Cluster
{
	vec4 boundingSphere;

	uint transformIndex;
	int materialIndex;

	uint indexCount;
	uint firstIndex;
	int vertexOffset;

	uint viewId;

	uint vertexCount;

	int padding2;
};
layout(binding = 0, std430) readonly buffer ClusterBuffer
{
	Cluster clusters[];
};

struct Vertex
{
	vec3 pos;
	float u;
	vec3 normal;
	float v;
};

layout(binding = 2, std430) readonly buffer VertexBuffer
{
	Vertex vertices[];
};

layout(binding = 3, std430) readonly buffer TransformBuffer
{
	mat4 transforms[];
};

layout(binding = 4, std430) readonly buffer IndexBuffer
{
	uint indices[];
};

layout (binding = 5, std430) buffer ClusterBatchBuffer
{
	uint clusterIds[];
};


uniform mat4 transform;
uniform vec3 camPos;



void main()
{
	uint clusterId = clusterIds[gl_WorkGroupID.x];

	for (int i = 0; i < 2; ++i)
	{
		uint v = gl_LocalInvocationID.x * 2 + (i);
		v = min(v, clusters[clusterId].vertexCount);

		uint vertexIndex = clusters[clusterId].vertexOffset + v;

		Vertex vertex = vertices[vertexIndex];

		gl_MeshVerticesNV[v].gl_Position = transform * transforms[clusters[clusterId].transformIndex] * vec4(vertex.pos, 1.0f);

		mat3 normalTransform = inverse(transpose(mat3(transforms[clusters[clusterId].transformIndex])));

		OUT[v].norm = normalTransform * vertex.normal;

		OUT[v].uv.x = vertex.u;
		OUT[v].uv.y = vertex.v;

		OUT[v].camPosMinusWorldVert = camPos - (transforms[clusters[clusterId].transformIndex] * vec4(vertex.pos, 1.0f)).xyz;

		OUT[v].clusterId = clusterId;
	}
	/*
	for (int i = 0; i < clusters[clusterId].vertexCount; ++i)
	{
		uint vertexIndex = clusters[clusterId].vertexOffset + i;

		Vertex vertex = vertices[vertexIndex];

		gl_MeshVerticesNV[i].gl_Position = transform * transforms[clusters[clusterId].transformIndex] * vec4(vertex.pos, 1.0f);
		/*
		mat3 normalTransform = inverse(transpose(mat3(transforms[clusters[clusterId].transformIndex])));

		OUT[i].norm = normalTransform * vertex.normal;

		OUT[i].uv.x = vertex.u;
		OUT[i].uv.y = vertex.v;

		OUT[i].camPosMinusWorldVert = camPos - (transforms[clusters[clusterId].transformIndex] * vec4(vertex.pos, 1.0f)).xyz;

		OUT[i].clusterId = clusterId;
		//*
	}
	*/
	
	/*
	for (int i = 0; i < clusters[clusterId].indexCount; ++i)
	{
		gl_PrimitiveIndicesNV[i] = indices[clusters[clusterId].firstIndex + i];
	}
	gl_PrimitiveCountNV = clusters[clusterId].indexCount / 3;
	*/

	for (int i = 0; i < 12; ++i)
	{
		uint n = gl_LocalInvocationID.x + (i * 32);
		n = min(n,  clusters[clusterId].indexCount);

		gl_PrimitiveIndicesNV[n] = indices[clusters[clusterId].firstIndex + n];
	}

	if (gl_LocalInvocationID.x == 0)
	{
		gl_PrimitiveCountNV = clusters[clusterId].indexCount / 3;
	}
}